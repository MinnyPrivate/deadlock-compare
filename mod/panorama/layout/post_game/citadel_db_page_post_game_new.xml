<!-- Valve layout reconstructed by Source 2 Viewer, plus DLCOMPARE additions (marked). -->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss" />
		<include src="s2r://panorama/styles/citadel_db_page_shared.vcss" />
		<include src="s2r://panorama/styles/post_game/citadel_db_page_post_game_new.vcss" />
		<include src="s2r://panorama/styles/loading_screen.vcss" />
		<!-- DLCOMPARE: overlay styles -->
		<include src="s2r://panorama/styles/dlcompare_overlay.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/post_game/citadel_db_page_post_game_new.vts" />
		<!-- DLCOMPARE: overlay script -->
		<include src="s2r://panorama/scripts/dlcompare_overlay.vjs_c" />
	</scripts>
	<snippets>
		<snippet name="CarouselNavItem">
			<Panel class="CarouselNavItem">
				<Panel class="Icon" />
				<Label text="{s:nav_text}" />
			</Panel>
		</snippet>
	</snippets>
	<CitadelPostGameNew class="DashboardPage" oncancel="CitadelNavigateBack();" dashboardclass="isShowingPostGamePage NoFooterBar" rendergame="false">
		<AsyncDataPanel class="Body" state="{d:match_load_state}">
			<Panel class="AsyncSuccessContainer">
				<Carousel id="ScreensCarousel" panels-visible="3">
					<Panel id="Team1Screen" class="Team PostGameScreen" acceptsfocus="true" navclass="Team1" navtooltip="#Citadel_Team1_Name">
						<Panel class="ScoreboardBackground" />
						<Label class="MatchMode" text="{s:match_mode}" />
						<Label id="MatchID" text="#Citadel_MatchDetails_MatchID" onmouseover="UIShowTextTooltip( #Citadel_PostGame_CopyMatchID )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPostGameCopyMatchID()" />
						<CitadelPostGameTeam id="Team1" />
					</Panel>
					<Panel id="Team2Screen" class="Team PostGameScreen" acceptsfocus="true" navclass="Team2" navtooltip="#Citadel_Team2_Name">
						<Panel class="ScoreboardBackground" />
						<Label class="MatchMode" text="{s:match_mode}" />
						<Label id="MatchID" text="#Citadel_MatchDetails_MatchID" onmouseover="UIShowTextTooltip( #Citadel_PostGame_CopyMatchID )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPostGameCopyMatchID()" />
						<CitadelPostGameTeam id="Team2" />
					</Panel>
					<Panel id="ScoreboardScreen" class="PostGameScreen Scoreboard" navclass="Scoreboard" navtooltip="#Citadel_Post_Game_Scoreboard">
						<Panel class="ScoreboardBackground" />
						<Label class="MatchMode" text="{s:match_mode}" />
						<Label id="MatchID" text="#Citadel_MatchDetails_MatchID" onmouseover="UIShowTextTooltip( #Citadel_PostGame_CopyMatchID )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPostGameCopyMatchID()" />
						<CitadelPostGameScoreboardNew id="Scoreboard" acceptsfocus="true" />
					</Panel>
					<Panel id="GraphsScreen" class="PostGameScreen Graphs" navclass="Graphs" navtooltip="#Citadel_Post_Game_Graphs_New">
						<Panel class="ScoreboardBackground" />
						<Label class="MatchMode" text="{s:match_mode}" />
						<Label id="MatchID" text="#Citadel_MatchDetails_MatchID" onmouseover="UIShowTextTooltip( #Citadel_PostGame_CopyMatchID )" onmouseout="UIHideTextTooltip()" onactivate="CitadelPostGameCopyMatchID()" />
						<MatchDetailsGraphs id="Graphs" class="DontShowSwitchPage" acceptsfocus="true" />
					</Panel>
				</Carousel>
				<Panel class="FooterBar" hittest="false">
					<Panel class="FooterBarBL">
						<CitadelBindingButton action="MenuBack" onactivate="CitadelNavigateBack()" text="#menu_exit_db_page" />
					</Panel>
					<Panel class="FooterBarMid" hittest="false">
						<Panel class="CarouselNav">
							<Button id="CarouselNavLeftArrow" class="CarouselNavArrow" onactivate="CitadelPostGameIncrementScreen( -1 )">
								<Panel class="NavArrowIcon" />
							</Button>
							<Panel id="CarouselNavItems" />
							<!-- DLCOMPARE: Compare nav icon, styled like the native screen icons -->
							<Button id="DLCompareNav" class="DLCompareNav">
								<Panel class="Icon" />
							</Button>
							<Button id="CarouselNavRightArrow" class="CarouselNavArrow" onactivate="CitadelPostGameIncrementScreen( 1 )">
								<Panel class="NavArrowIcon" />
							</Button>
						</Panel>
						<Panel id="PlayAgainButton" hittest="false">
							<MoviePanel id="PlayButtonFX" class="btn_fx" src="file://{resources}/videos/pick_screen/play_btn_grn_flame.webm" scaling="stretch" repeat="true" disableaudio="true" autoplay="onload" hittest="false" />
							<Panel class="buttonContent" onactivate="CitadelPostGamePlayAgain()">
								<Panel class="btn_bg" />
								<Panel class="btn_texture" />
								<SplitLabel text="#Citadel_Post_Game_Requeue" />
							</Panel>
						</Panel>
					</Panel>
					<Panel class="FooterBarBR">
						<MatchDetailsReplayButton id="ReplayButton" />
					</Panel>
				</Panel>
			</Panel>
			<Panel class="AsyncFailureContainer">
				<Panel class="ErrorContents">
					<Label class="ErrorMsg" text="{s:match_load_error}" />
					<Button id="RetryButton" class="PopupButton" onactivate="CitadelMatchDetailsRetry()">
						<Label text="#Citadel_Post_Game_Retry" />
					</Button>
				</Panel>
			</Panel>
			<Panel class="AsyncLoadingContainer">
				<Panel class="LoadingDetails">
					<Panel class="SpinnerContainer">
						<Panel class="SpinnerOuter" />
						<Panel class="SpinnerInner" />
					</Panel>
				</Panel>
			</Panel>
		</AsyncDataPanel>
		<CitadelCommendNotification id="CommendNotification" />
		<!-- DLCOMPARE: Compare screen, fills everything above the footer nav bar -->
		<Panel id="DLCompareOverlay" hittest="true">
			<CitadelHTMLPanel id="DLCompareWeb" />
		</Panel>
	</CitadelPostGameNew>
</root>
